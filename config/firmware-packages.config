# ==============================================================================
# RTL9617C 固件软件包配置（OpenWrt .config 片段）
# ==============================================================================
#
# 这个文件由 .github/workflows/build-firmware.yml 在编译前追加到 .config，
# 随后执行 `make defconfig` 自动补全依赖。
#
# 自定义软件包：
#   - 增加：写一行  CONFIG_PACKAGE_<包名>=y
#   - 删除：改成  # CONFIG_PACKAGE_<包名> is not set
#   - 也可以在 GitHub Actions 手动触发时用 extra_packages 参数临时追加，
#     多个包用空格分隔，例如：luci-app-upnp htop curl
#
# 主题约定：
#   仅保留 luci-theme-bootstrap。下方显式关闭其它 LuCI 主题；
#   工作流还会把 target/linux/rtl9617c/image/Makefile 的 DEVICE_PACKAGES
#   中硬编码的 luci-theme-argon 替换为 luci-theme-bootstrap。
#
# 注意：
#   - 目标设备选择由工作流注入（CONFIG_TARGET_rtl9617c=y 等），此处不要重复定义。
#   - PON 控制、QoS、Wi-Fi 固件等设备专属包来自 DEVICE_PACKAGES，是机器正常
#     工作的必需组件，不属于主题范畴，因此不在此处移除。
#
# ==============================================================================

# ------------------------------------------------------------------------------
# LuCI Web 界面
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 关闭其它主题，保证固件里只有 bootstrap
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-design is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set

# ------------------------------------------------------------------------------
# WireGuard
# luci-proto-wireguard 依赖 wireguard-tools；kmod-wireguard 是内核模块。
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# ------------------------------------------------------------------------------
# 常用可选软件包（按需取消注释）
# ------------------------------------------------------------------------------
# 说明：启用某个包时请删掉行首的 "# "，并让 CONFIG_ 顶格（前面不能有空格）。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_openssh-sftp-server=y
# CONFIG_PACKAGE_luci-app-upnp=y
# CONFIG_PACKAGE_luci-app-ddns=y
